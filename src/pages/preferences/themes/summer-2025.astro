---
export const theme = {
  id: "summer25",
  displayName: "Summer 2025",
  notchLabel: "Sommar 25",
  status: "Active",
  notchColor: "#dfeef2",
  slug: "summer-2025",
  summary: "Planning context for the Summer 2025 decision window.",
};

const siteTitle = `Theme: ${theme.displayName} – La Familia`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <style>
      :root {
        color-scheme: light;
        --text: #1f2933;
        --muted: #5b6570;
        --border: #d7dce1;
        --surface: #ffffff;
        --accent: #2f5d7c;
        --background: #f6f7f9;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
        color: var(--text);
        background: var(--background);
      }

      main {
        max-width: 960px;
        margin: 0 auto;
        padding: 64px 24px 104px;
        display: flex;
        flex-direction: column;
        gap: 32px;
      }

      h1,
      h2 {
        margin: 0 0 12px;
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      h1 {
        font-size: 2.4rem;
        line-height: 1.2;
      }

      h2 {
        font-size: 1.1rem;
        letter-spacing: -0.01em;
        color: var(--text);
      }

      p {
        margin: 0 0 16px;
        line-height: 1.6;
        color: var(--text);
      }

      ul {
        margin: 0;
        padding-left: 18px;
        line-height: 1.6;
      }

      .section {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 28px 32px;
      }

      .subtitle {
        color: var(--muted);
        font-size: 1.02rem;
        max-width: 720px;
      }

      .note {
        color: var(--muted);
        font-size: 0.98rem;
      }
    </style>
  </head>
  <body>
    <main>
      <section class="section">
        <h1>Theme: {theme.displayName}</h1>
        <p class="subtitle">
          Planning context for Summer 2025 decisions, anchored on calm pacing, clear logistics, and
          family-friendly recovery time.
        </p>
        <p class="note">Status: {theme.status}. This theme frames the current shortlist.</p>
      </section>

      <section class="section">
        <h2>Planning focus</h2>
        <ul>
          <li>Prioritize destinations that support predictable weather and manageable transit.</li>
          <li>Balance active days with recovery time to prevent over-scheduling.</li>
          <li>Keep accommodations and transportation aligned with family-size practicality.</li>
        </ul>
      </section>

      <section class="section">
        <h2>Experience constraints</h2>
        <ul>
          <li>Daily routines should allow early rest and flexible meal options.</li>
          <li>Limit internal moves; prefer one primary base with optional day trips.</li>
          <li>Reserve at least one low-effort day for rest or quiet exploration.</li>
        </ul>
      </section>

      <section class="section">
        <h2>Open questions</h2>
        <ul>
          <li>Confirm target travel window within the summer break.</li>
          <li>Finalize budget guardrails for lodging and intra-region transfers.</li>
        </ul>
      </section>
    </main>
  </body>
</html>
