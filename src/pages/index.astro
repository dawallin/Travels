---
import { theme as summer25Theme } from "./preferences/themes/summer-2025.astro";
import { theme as rainforestTheme } from "./preferences/themes/summer-rainforest-snorkeling.astro";
import { theme as skiTheme } from "./preferences/themes/ski-trip.astro";

const siteTitle = "La Familia – Travel Planning";
const planningThemes = [summer25Theme, rainforestTheme, skiTheme];
const baliTheme = summer25Theme;
const truncateBanner = (label) => (label.length > 10 ? `${label.slice(0, 9)}…` : label);
const baselineBanner = {
  label: "Baseline",
  color: "#e4e7eb",
};
const tripBanner = {
  label: "Trip",
  color: "#e4e7eb",
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <style>
      :root {
        color-scheme: light;
        --text: #1f2933;
        --muted: #5b6570;
        --border: #d7dce1;
        --surface: #ffffff;
        --accent: #2f5d7c;
        --background: #f6f7f9;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
        color: var(--text);
        background: var(--background);
      }

      main {
        max-width: 960px;
        margin: 0 auto;
        padding: 64px 24px 104px;
        display: flex;
        flex-direction: column;
        gap: 48px;
      }

      h1,
      h2,
      h3 {
        margin: 0 0 12px;
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      h1 {
        font-size: 2.6rem;
        line-height: 1.15;
      }

      h2 {
        font-size: 1.2rem;
        letter-spacing: -0.01em;
        color: var(--text);
      }

      p {
        margin: 0 0 18px;
        line-height: 1.6;
        color: var(--text);
      }

      .section {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 32px 36px;
      }

      .section-header {
        margin-bottom: 16px;
      }

      .subtitle {
        color: var(--muted);
        font-size: 1.05rem;
        max-width: 640px;
      }

      .identity {
        display: grid;
        gap: 20px;
      }

      .context {
        color: var(--muted);
        font-size: 0.98rem;
        max-width: 720px;
      }


      .travel-ideas {
        display: grid;
        gap: 18px;
      }

      .idea-card {
        display: grid;
        grid-template-columns: 88px 1fr;
        gap: 16px;
        border: 1px solid var(--border);
        border-radius: 10px;
        text-decoration: none;
        color: inherit;
        background: #fbfbfc;
        position: relative;
        overflow: hidden;
      }

      .idea-card:hover,
      .idea-card:focus {
        border-color: var(--accent);
      }

      .baseline-card {
        background: #f5f6f8;
      }

      .frameworks {
        display: grid;
        gap: 20px;
      }

      .frameworks-divider {
        height: 1px;
        background: var(--border);
        border-radius: 999px;
      }

      .idea-banner {
        background: var(--banner-color, #e6ebef);
        color: var(--text);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 12px 8px;
        border-right: 1px solid var(--border);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .idea-card-content {
        display: grid;
        gap: 8px;
        padding: 20px 20px 20px 4px;
      }

      .idea-title {
        font-size: 1.05rem;
        font-weight: 600;
      }

      .idea-meta {
        color: var(--muted);
        font-size: 0.9rem;
      }

      @media (min-width: 768px) {
        .travel-ideas {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="section identity">
        <div class="section-header">
          <h1>{siteTitle}</h1>
          <p class="subtitle">
            Shared workspace for exploring, comparing, and documenting travel options before any
            commitments are made.
          </p>
        </div>
        <p class="context">
          This private planning archive supports iterative comparison for our family and trusted
          travel advisors, consolidating notes and options as decisions are refined.
        </p>
      </section>

      <section class="section">
        <h2>Who we are</h2>
        <p>
          Family of five: two parents and three teenagers (ages 15, 18, 19). Trips are planned
          together and reviewed against shared priorities and constraints.
        </p>
      </section>

      <section class="section">
        <h2>How we use this site</h2>
        <p>
          Planning is a staged process. Ideas are collected, compared, and refined over multiple
          rounds. Not every option becomes a trip, and incomplete notes are expected while research
          is still in progress.
        </p>
        <p>
          Each idea is treated as a working file with assumptions, alternatives, and open questions
          until a final decision is made.
        </p>
        <p>
          Baseline preferences and theme-specific criteria live in the
          <a href="preferences/baseline/">baseline reference</a> and the
          <a href="preferences/themes/summer-2025/">active themes</a>.
        </p>
      </section>

      <section class="section">
        <h2>Planning frameworks</h2>
        <div class="frameworks">
          <div class="travel-ideas">
            <a
              class="idea-card baseline-card"
              href="preferences/baseline/"
              style={`--banner-color: ${baselineBanner.color}`}
            >
              <span class="idea-banner">{truncateBanner(baselineBanner.label)}</span>
              <div class="idea-card-content">
                <span class="idea-title">Travel preferences – baseline</span>
                <span class="idea-meta">
                  General criteria and constraints used to evaluate travel ideas.
                </span>
                <span class="idea-meta">Reference</span>
              </div>
            </a>
          </div>
          <div class="frameworks-divider" aria-hidden="true"></div>
          <div class="travel-ideas">
            {planningThemes.map((theme) => (
              <a
                class="idea-card"
                href={`preferences/themes/${theme.slug}/`}
                style={`--banner-color: ${theme.bannerColor}`}
              >
                <span class="idea-banner">{truncateBanner(theme.bannerLabel)}</span>
                <div class="idea-card-content">
                  <span class="idea-title">Theme: {theme.displayName}</span>
                  <span class="idea-meta">{theme.summary}</span>
                  <span class="idea-meta">{theme.status}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="section">
        <h2>Travel ideas</h2>
        <div class="travel-ideas">
          <a
            class="idea-card"
            href="trips/bali/"
            style={`--banner-color: ${baliTheme.bannerColor}`}
          >
            <span class="idea-banner">{truncateBanner(baliTheme.bannerLabel)}</span>
            <div class="idea-card-content">
              <span class="idea-title">Bali</span>
              <span class="idea-meta">
                Status: active research • Focus: routing + lodging scenarios
              </span>
            </div>
          </a>
          <a class="idea-card" href="trips/portugal/" style={`--banner-color: ${tripBanner.color}`}>
            <span class="idea-banner">{truncateBanner(tripBanner.label)}</span>
            <div class="idea-card-content">
              <span class="idea-title">Portugal</span>
              <span class="idea-meta">
                Status: placeholder • Focus: regional options under review
              </span>
            </div>
          </a>
          <a class="idea-card" href="trips/japan/" style={`--banner-color: ${tripBanner.color}`}>
            <span class="idea-banner">{truncateBanner(tripBanner.label)}</span>
            <div class="idea-card-content">
              <span class="idea-title">Japan</span>
              <span class="idea-meta">Status: placeholder • Focus: season timing and transit costs</span>
            </div>
          </a>
        </div>
      </section>
    </main>
  </body>
</html>
