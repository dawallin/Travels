---
import { theme as summer25Theme } from "./preferences/themes/summer-2025.astro";
import Card from "../components/Card.astro";
import DebugDock from "../components/DebugDock.astro";

const siteTitle = "La Familia – Travel Planning";
const planningThemes = [summer25Theme];
const themesById = Object.fromEntries(planningThemes.map((theme) => [theme.id, theme]));
const truncateNotch = (label) => (label.length > 10 ? `${label.slice(0, 9)}…` : label);
const baselineNotch = {
  label: "Baseline",
  color: "#e4e7eb",
};
const trips = [
  {
    destination: "Bali",
    href: "trips/bali/",
    themeIds: ["summer25"],
    status: "Status: active research • Focus: routing + lodging scenarios",
  },
  {
    destination: "Seychellerna",
    href: "trips/seychelles/",
    themeIds: ["summer25"],
    status: "Status: active research • Focus: island hopping + beach stays",
  },
];
const getTripNotches = (themeIds) =>
  themeIds
    .map((id) => themesById[id])
    .filter(Boolean)
    .slice(0, 2)
    .map((theme) => ({
      label: theme.notchLabel,
      color: theme.notchColor,
    }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <style>
      :root {
        color-scheme: light;
        --text: #1f2933;
        --muted: #5b6570;
        --border: #d7dce1;
        --surface: #ffffff;
        --accent: #2f5d7c;
        --background: #f6f7f9;
        --notch-width: 12px;
        --notch-gap: 4px;
        --notch-padding: 6px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
        color: var(--text);
        background: var(--background);
      }

      main {
        max-width: 960px;
        margin: 0 auto;
        padding: 64px 24px 104px;
        display: flex;
        flex-direction: column;
        gap: 48px;
      }

      h1,
      h2,
      h3 {
        margin: 0 0 12px;
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      h1 {
        font-size: 2.6rem;
        line-height: 1.15;
      }

      h2 {
        font-size: 1.2rem;
        letter-spacing: -0.01em;
        color: var(--text);
      }

      p {
        margin: 0 0 18px;
        line-height: 1.6;
        color: var(--text);
      }

      .section {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 32px 36px;
      }

      .section-header {
        margin-bottom: 16px;
      }

      .subtitle {
        color: var(--muted);
        font-size: 1.05rem;
        max-width: 640px;
      }

      .identity {
        display: grid;
        gap: 20px;
      }

      .context {
        color: var(--muted);
        font-size: 0.98rem;
        max-width: 720px;
      }


      .travel-ideas {
        display: grid;
        gap: 18px;
      }

      .baseline-card {
        background: #f5f6f8;
      }

      .frameworks {
        display: grid;
        gap: 20px;
      }

      .frameworks-divider {
        height: 1px;
        background: var(--border);
        border-radius: 999px;
      }

      @media (min-width: 768px) {
        .travel-ideas {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
    </style>
  </head>
  <body>
    <DebugDock />
    <main>
      <section class="section identity">
        <div class="section-header">
          <h1>{siteTitle}</h1>
          <p class="subtitle">
            Shared workspace for exploring, comparing, and documenting travel options before any
            commitments are made.
          </p>
        </div>
        <p class="context">
          This private planning archive supports iterative comparison for our family and trusted
          travel advisors, consolidating notes and options as decisions are refined.
        </p>
      </section>

      <section class="section">
        <h2>Who we are</h2>
        <p>
          Family of five: two parents and three teenagers (ages 15, 18, 19). Trips are planned
          together and reviewed against shared priorities and constraints.
        </p>
      </section>

      <section class="section">
        <h2>How we use this site</h2>
        <p>
          Planning is a staged process. Ideas are collected, compared, and refined over multiple
          rounds. Not every option becomes a trip, and incomplete notes are expected while research
          is still in progress.
        </p>
        <p>
          Each idea is treated as a working file with assumptions, alternatives, and open questions
          until a final decision is made.
        </p>
        <p>
          Baseline preferences and theme-specific criteria live in the
          <a href="preferences/baseline/">baseline reference</a> and the
          <a href="preferences/themes/summer-2025/">active themes</a>.
        </p>
      </section>

      <section class="section">
        <h2>Planning frameworks</h2>
        <div class="frameworks">
          <div class="travel-ideas">
            <Card
              class="baseline-card"
              title="Travel preferences – baseline"
              href="preferences/baseline/"
              notches={[{ label: truncateNotch(baselineNotch.label), color: baselineNotch.color }]}
            >
              <div slot="description">
                <span>General criteria and constraints used to evaluate travel ideas.</span>
                <span>Reference</span>
              </div>
            </Card>
          </div>
          <div class="frameworks-divider" aria-hidden="true"></div>
          <div class="travel-ideas">
            {planningThemes.map((theme) => (
              <Card
                title={`Theme: ${theme.displayName}`}
                href={`preferences/themes/${theme.slug}/`}
                notches={[{ label: truncateNotch(theme.notchLabel), color: theme.notchColor }]}
              >
                <div slot="description">
                  <span>{theme.summary}</span>
                  <span>{theme.status}</span>
                </div>
              </Card>
            ))}
          </div>
        </div>
      </section>

      <section class="section">
        <h2>Travel ideas</h2>
        <div class="travel-ideas">
          {trips.map((trip) => {
            const notches = getTripNotches(trip.themeIds);
            return (
              <Card
                title={trip.destination}
                description={trip.status}
                href={trip.href}
                notches={notches.map((notch) => ({
                  label: truncateNotch(notch.label),
                  color: notch.color,
                }))}
              />
            );
          })}
        </div>
      </section>
    </main>
  </body>
</html>
