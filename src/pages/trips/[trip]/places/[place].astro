---
import PlaceLayout from "../../../../layouts/PlaceLayout.astro";
import { getAllPlaces } from "../../../../data/places";
import type { Place, PlaceDetails, PlaceLinks } from "../../../../data/places/types";

interface RenderableLink {
  label: string;
  url: string;
}

interface DynamicPlaceParams {
  trip: string;
  place: string;
}

const isStrictDetails = (details: unknown): details is PlaceDetails =>
  Boolean(details && typeof details === "object" && !Array.isArray(details) && "what" in details);

const linksFromStrictObject = (links: PlaceLinks | undefined, place: Place): { knownLinks: RenderableLink[]; otherLinks: RenderableLink[] } => {
  const knownLinks: RenderableLink[] = [];
  const otherLinks: RenderableLink[] = [];

  if (links?.googleMaps) {
    knownLinks.push({ label: "Google Maps", url: links.googleMaps });
  } else if (place.googleMapsUrl) {
    knownLinks.push({ label: "Google Maps", url: place.googleMapsUrl });
  }

  if (links?.tripAdvisor) {
    knownLinks.push({ label: "TripAdvisor", url: links.tripAdvisor });
  } else if (place.tripadvisorUrl) {
    knownLinks.push({ label: "TripAdvisor", url: place.tripadvisorUrl });
  }

  if (links?.official) {
    knownLinks.push({ label: "Official website", url: links.official });
  }

  if (links?.other?.length) {
    otherLinks.push(
      ...links.other
        .filter((link) => Boolean(link?.url))
        .map((link) => ({
          label: link.label || link.url,
          url: link.url,
        })),
    );
  }

  return { knownLinks, otherLinks };
};

const { place, trip } = Astro.props;
const details = isStrictDetails(place.details) ? place.details : undefined;
const fallbackHighlights = !details && Array.isArray(place.details?.highlights) ? place.details.highlights : place.highlights;
const { knownLinks, otherLinks } = linksFromStrictObject(place.links, place);
const hasAnyLinks = knownLinks.length > 0 || otherLinks.length > 0;

export async function getStaticPaths() {
  return getAllPlaces().map(({ trip, place }) => ({
      params: {
        trip,
        place: place.id,
      } satisfies DynamicPlaceParams,
      props: {
        trip,
        place,
      },
    }));
}

const backLabel = `← Back to ${trip.charAt(0).toUpperCase()}${trip.slice(1)} overview`;
---
<PlaceLayout title={place.title} backHref={`../../`} backLabel={backLabel}>
  {details?.what ? <p>{details.what}</p> : <p>{place.description}</p>}

  {details?.summary ? <p>{details.summary}</p> : null}

  {details?.highlights?.length ? (
    <>
      <h2>Highlights</h2>
      <ul>
        {details.highlights.map((highlight) => (
          <li>{highlight}</li>
        ))}
      </ul>
    </>
  ) : fallbackHighlights?.length ? (
    <>
      <h2>Highlights</h2>
      <ul>
        {fallbackHighlights.map((highlight) => (
          <li>{highlight}</li>
        ))}
      </ul>
    </>
  ) : null}

  {details?.tips?.length ? (
    <>
      <h2>Tips</h2>
      <ul>
        {details.tips.map((tip) => (
          <li>{tip}</li>
        ))}
      </ul>
    </>
  ) : null}

  {details?.goodToKnow?.length ? (
    <>
      <h2>Good to know</h2>
      <ul>
        {details.goodToKnow.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </>
  ) : null}

  {details?.bestTime ? (
    <>
      <h2>Best time</h2>
      <p>{details.bestTime}</p>
    </>
  ) : null}

  {hasAnyLinks ? (
    <>
      <h2>Links</h2>
      {knownLinks.length ? (
        <ul>
          {knownLinks.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noreferrer">{link.label}</a>
            </li>
          ))}
        </ul>
      ) : null}
      {otherLinks.length ? (
        <>
          <h3>Other</h3>
          <ul>
            {otherLinks.map((link) => (
              <li>
                <a href={link.url} target="_blank" rel="noreferrer">{link.label}</a>
              </li>
            ))}
          </ul>
        </>
      ) : null}
    </>
  ) : null}
</PlaceLayout>
