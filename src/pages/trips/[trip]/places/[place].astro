---
import PlaceLayout from "../../../../layouts/PlaceLayout.astro";
import { getAllPlaces } from "../../../../data/places";
import type { Place, PlaceDetails, PlaceLinks, LegacyPlaceLink } from "../../../../data/places/types";

interface RenderableLink {
  label: string;
  url: string;
  isOther?: boolean;
}

interface DynamicPlaceParams {
  trip: string;
  place: string;
}

const isStrictLinks = (links: unknown): links is PlaceLinks => {
  if (!links || Array.isArray(links)) {
    return false;
  }

  const candidate = links as Record<string, unknown>;
  const allowedKeys = ["googleMaps", "tripAdvisor", "official"];

  return Object.keys(candidate).every((key) => allowedKeys.includes(key));
};

const isStrictDetails = (details: unknown): details is PlaceDetails =>
  Boolean(details && typeof details === "object" && !Array.isArray(details) && "what" in details);

const labelForLegacyLinkType = (type: string): string => {
  if (type === "google-maps") {
    return "Google Maps";
  }

  if (type === "tripadvisor") {
    return "TripAdvisor";
  }

  if (type === "official") {
    return "Official website";
  }

  return "Other";
};

const getReadableUrlLabel = (url: string): string => {
  try {
    const { hostname } = new URL(url);
    const normalized = hostname.replace(/^www\./, "");
    return normalized || url;
  } catch {
    return url;
  }
};

const linksFromStrictObject = (links: PlaceLinks): RenderableLink[] => {
  const renderable: RenderableLink[] = [];

  if (links.googleMaps) {
    renderable.push({ label: "Google Maps", url: links.googleMaps });
  }

  if (links.tripAdvisor) {
    renderable.push({ label: "TripAdvisor", url: links.tripAdvisor });
  }

  if (links.official) {
    renderable.push({ label: "Official website", url: links.official });
  }

  return renderable;
};

const linksFromLegacyArray = (links: LegacyPlaceLink[] | undefined): RenderableLink[] => {
  if (!links) {
    return [];
  }

  return links
    .filter((link) => Boolean(link?.url))
    .map((link) => {
      const typedLabel = labelForLegacyLinkType(link.type);
      const isOther = typedLabel === "Other";

      return {
        label: isOther ? getReadableUrlLabel(link.url) : typedLabel,
        url: link.url,
        isOther,
      };
    });
};

const getRenderableLinks = (place: Place): RenderableLink[] => {
  const placeLinks = place.links;

  if (isStrictLinks(placeLinks)) {
    return linksFromStrictObject(placeLinks);
  }

  if (Array.isArray(placeLinks)) {
    const renderable = linksFromLegacyArray(placeLinks);

    if (!placeLinks.some((link) => link.type === "google-maps") && place.googleMapsUrl) {
      renderable.push({ label: "Google Maps", url: place.googleMapsUrl });
    }

    if (!placeLinks.some((link) => link.type === "tripadvisor") && place.tripadvisorUrl) {
      renderable.push({ label: "TripAdvisor", url: place.tripadvisorUrl });
    }

    return renderable;
  }

  const fallbackLinks: RenderableLink[] = [];

  if (place.googleMapsUrl) {
    fallbackLinks.push({ label: "Google Maps", url: place.googleMapsUrl });
  }

  if (place.tripadvisorUrl) {
    fallbackLinks.push({ label: "TripAdvisor", url: place.tripadvisorUrl });
  }

  return fallbackLinks;
};

const { place, trip } = Astro.props;
const details = isStrictDetails(place.details) ? place.details : undefined;
const fallbackHighlights = !details && Array.isArray(place.details?.highlights) ? place.details.highlights : place.highlights;
const links = getRenderableLinks(place);
const knownLinks = links.filter((link) => !link.isOther);
const otherLinks = links.filter((link) => link.isOther);

export async function getStaticPaths() {
  return getAllPlaces().map(({ trip, place }) => ({
      params: {
        trip,
        place: place.id,
      } satisfies DynamicPlaceParams,
      props: {
        trip,
        place,
      },
    }));
}

const backLabel = `← Back to ${trip.charAt(0).toUpperCase()}${trip.slice(1)} overview`;
---
<PlaceLayout title={place.title} backHref={`../../`} backLabel={backLabel}>
  {details?.what ? <p>{details.what}</p> : <p>{place.description}</p>}

  {details?.summary ? <p>{details.summary}</p> : null}

  {details?.highlights?.length ? (
    <>
      <h2>Highlights</h2>
      <ul>
        {details.highlights.map((highlight) => (
          <li>{highlight}</li>
        ))}
      </ul>
    </>
  ) : fallbackHighlights?.length ? (
    <>
      <h2>Highlights</h2>
      <ul>
        {fallbackHighlights.map((highlight) => (
          <li>{highlight}</li>
        ))}
      </ul>
    </>
  ) : null}

  {details?.tips?.length ? (
    <>
      <h2>Tips</h2>
      <ul>
        {details.tips.map((tip) => (
          <li>{tip}</li>
        ))}
      </ul>
    </>
  ) : null}

  {details?.goodToKnow?.length ? (
    <>
      <h2>Good to know</h2>
      <ul>
        {details.goodToKnow.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </>
  ) : null}

  {details?.bestTime ? (
    <>
      <h2>Best time</h2>
      <p>{details.bestTime}</p>
    </>
  ) : null}

  {links.length ? (
    <>
      <h2>Links</h2>
      <ul>
        {knownLinks.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noreferrer">{link.label}</a>
          </li>
        ))}
      </ul>
      {otherLinks.length ? (
        <>
          <h3>Other</h3>
          <ul>
            {otherLinks.map((link) => (
              <li>
                <a href={link.url} target="_blank" rel="noreferrer">{link.label}</a>
              </li>
            ))}
          </ul>
        </>
      ) : null}
    </>
  ) : null}
</PlaceLayout>
