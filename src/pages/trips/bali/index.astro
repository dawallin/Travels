---
import PageHeader from "../../../components/PageHeader.astro";
import PlacesOverview from "../../../components/PlacesOverview.astro";

const destination = "Bali";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{destination} • Travels</title>
    <style>
      :root {
        color-scheme: light;
        --text: #1f2933;
        --muted: #5b6570;
        --border: #d7dce1;
        --surface: #ffffff;
        --accent: #2f5d7c;
        --background: #f6f7f9;
        --notch-width: 12px;
        --notch-gap: 4px;
        --notch-padding: 6px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
        color: var(--text);
        background: var(--background);
      }

      main {
        max-width: 960px;
        margin: 0 auto;
        padding: 64px 24px 104px;
        display: flex;
        flex-direction: column;
        gap: 32px;
      }

      h1 {
        margin: 0 0 12px;
        font-size: 2.4rem;
        letter-spacing: -0.02em;
      }

      h2 {
        margin: 0 0 12px;
        font-size: 1.2rem;
        letter-spacing: -0.01em;
      }

      p {
        margin: 0 0 18px;
        line-height: 1.6;
        color: var(--text);
      }

      .back-link {
        display: inline-block;
        margin-bottom: 12px;
        color: var(--muted);
        text-decoration: none;
        font-size: 0.95rem;
      }

      .back-link:hover {
        color: var(--text);
        text-decoration: underline;
      }

      .section {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 32px 36px;
      }

      .intro {
        color: var(--muted);
        max-width: 720px;
      }

      .section-intro {
        color: var(--muted);
        max-width: 720px;
      }
    </style>
  </head>
  <body>
    <main>
      <PageHeader title={destination} backHref="../../" backLabel="← Back to trips">
        <p class="intro">
          Research snapshot for destinations and supporting stays currently under consideration.
        </p>
      </PageHeader>
      <section class="section">
        <h2>Places overview</h2>
        <p class="section-intro">
          Destinations are grouped with their immediate hotels and attractions. Status badges
          highlight how each place is currently tracked.
        </p>
        <PlacesOverview />
      </section>
    </main>
  </body>
</html>
