---
import mapWidgetScript from "../scripts/mapWidget.js?url";
import { placeStatusLabels, placeTypeIcons, placeTypeLabels } from "./placePresentation";

const {
  markers = [],
  title,
  subtitle,
  mapId = "bali-map",
  singleMarkerZoom = 11,
} = Astro.props;
if (!title) {
  throw new Error("[MapWidget] title prop is required.");
}
const resolvedTitle = title;
const resolvedSubtitle = subtitle;
const ariaLabel = resolvedSubtitle ? `${resolvedTitle} — ${resolvedSubtitle}` : resolvedTitle;
const fullscreenMapId = `${mapId}-fullscreen`;

const mapTilerKey = import.meta.env.PUBLIC_MAPTILER_KEY;
const normalizedMarkers = Array.isArray(markers) ? markers : [];
const markerSummaries = normalizedMarkers.map((marker) => {
  const title = marker.title ?? marker.name ?? "(untitled)";
  const rawLat = marker.lat ?? marker.latitude;
  const rawLon = marker.lon ?? marker.lng ?? marker.longitude;
  const type = marker.type ?? marker.kind ?? marker.category ?? "";
  const status = marker.status ?? "included";
  const description = marker.description ?? "";
  const href = marker.href ?? marker.url ?? "";
  const lat = Number(rawLat);
  const lon = Number(rawLon);
  const issues: string[] = [];

  if (rawLat == null) {
    issues.push("lat missing");
  } else if (!Number.isFinite(lat)) {
    issues.push("lat invalid");
  } else if (Math.abs(lat) > 90) {
    issues.push("lat out of range");
  }

  if (rawLon == null) {
    issues.push("lon missing");
  } else if (!Number.isFinite(lon)) {
    issues.push("lon invalid");
  } else if (Math.abs(lon) > 180) {
    issues.push("lon out of range");
  }

  return {
    title,
    rawLat,
    rawLon,
    type,
    status,
    description,
    href,
    lat,
    lon,
    issues,
  };
});
const normalizeKey = (value) => String(value ?? "").trim().toLowerCase();
const normalizeStatus = (value) => {
  const normalized = normalizeKey(value);
  if (normalized === "possible" || normalized === "avoid") {
    return normalized;
  }
  return "included";
};
const normalizeType = (value) => {
  const normalized = normalizeKey(value);
  if (
    normalized === "hotel" ||
    normalized === "activity" ||
    normalized === "attraction" ||
    normalized === "restaurant" ||
    normalized === "shopping"
  ) {
    return normalized;
  }
  return "destination";
};
const getMarkerPresentation = (marker) => {
  const typeKey = normalizeType(marker.type);
  const statusKey = normalizeStatus(marker.status);
  return {
    typeKey,
    statusKey,
    statusClass: `status-${statusKey}`,
    typeLabel: placeTypeLabels[typeKey] ?? "Place",
    statusLabel: placeStatusLabels[statusKey] ?? "Included",
    glyph: placeTypeIcons[typeKey] ?? placeTypeIcons.destination,
  };
};
const validMarkers = markerSummaries
  .filter((marker) => marker.issues.length === 0)
  .map((marker) => ({
    title: marker.title,
    lat: marker.lat,
    lon: marker.lon,
    type: marker.type ?? marker.kind ?? marker.category ?? "",
    status: marker.status ?? "included",
    description: marker.description ?? "",
    href: marker.href ?? "",
    ...getMarkerPresentation(marker),
  }));
const invalidMarkers = markerSummaries
  .filter((marker) => marker.issues.length > 0)
  .map((marker) => ({
    title: marker.title,
    rawLat: marker.rawLat ?? "",
    rawLon: marker.rawLon ?? "",
    issues: marker.issues,
  }));

const totalMarkers = normalizedMarkers.length;
const validMarkersCount = validMarkers.length;
const invalidMarkersCount = invalidMarkers.length;

if (!mapTilerKey) {
  console.warn("[MapWidget] Missing PUBLIC_MAPTILER_KEY; map hidden.");
}

const shouldRenderMap = Boolean(mapTilerKey) && validMarkers.length > 0;
const mapConfig = {
  label: ariaLabel,
  mapId,
  fullscreenMapId,
  markers: validMarkers,
  mapTilerKey,
  singleMarkerZoom,
  totalMarkers,
  validMarkersCount,
  invalidMarkersCount,
  invalidMarkers,
  shouldRenderMap,
};
---
{shouldRenderMap && (
  <section
    class="map-widget"
    aria-label={ariaLabel}
    data-map-widget
    data-map-config={JSON.stringify(mapConfig)}
  >
    <header class="map-widget__header">
      <div class="map-widget__titles">
        <h3 class="map-widget__title">{resolvedTitle}</h3>
        {resolvedSubtitle && <p class="map-widget__subtitle">{resolvedSubtitle}</p>}
      </div>
      <button class="map-toggle" type="button" data-map-widget-toggle aria-label="Expand map">
        <span class="map-toggle__icon map-toggle__icon--expand" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
            <path
              d="M9 3H3v6M3 3l7 7M15 21h6v-6M21 21l-7-7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <span class="map-toggle__icon map-toggle__icon--collapse" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
            <path
              d="M3 9h6V3M3 9l7-7M21 15h-6v6M21 15l-7 7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </button>
    </header>
    <div
      id={mapId}
      class="map-canvas"
      aria-label={`${ariaLabel} map`}
      role="region"
    ></div>
    <div class="map-modal" data-map-widget-modal aria-hidden="true" hidden>
      <div
        class="map-modal__content"
        role="dialog"
        aria-modal="true"
        aria-label={`${ariaLabel} fullscreen map`}
      >
        <header class="map-widget__header map-widget__header--modal">
          <div class="map-widget__titles">
            <h3 class="map-widget__title">{resolvedTitle}</h3>
            {resolvedSubtitle && <p class="map-widget__subtitle">{resolvedSubtitle}</p>}
          </div>
          <button
            class="map-toggle map-toggle--fullscreen"
            type="button"
            data-map-widget-toggle
            aria-label="Collapse map"
          >
            <span class="map-toggle__icon map-toggle__icon--expand" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                <path
                  d="M9 3H3v6M3 3l7 7M15 21h6v-6M21 21l-7-7"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <span class="map-toggle__icon map-toggle__icon--collapse" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                <path
                  d="M3 9h6V3M3 9l7-7M21 15h-6v6M21 15l-7 7"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </button>
        </header>
        <div
          id={fullscreenMapId}
          class="map-canvas map-canvas--fullscreen"
          aria-label={`${ariaLabel} fullscreen map`}
          role="region"
        ></div>
      </div>
    </div>
  </section>
)}

{!shouldRenderMap && (
  <div data-map-widget hidden data-map-config={JSON.stringify(mapConfig)}></div>
)}

<!-- Leaflet assets load via CDN to avoid bare module imports on static hosting. -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  crossorigin="anonymous"
/>
<script
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  defer
  crossorigin="anonymous"
></script>
<script src={mapWidgetScript} defer></script>

<style>
  .map-widget {
    display: grid;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .map-widget__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    background: var(--surface);
  }

  .map-widget__header--modal {
    background: #0b0f14;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .map-widget__header--modal .map-widget__title {
    color: #f4f6f8;
  }

  .map-widget__header--modal .map-widget__subtitle {
    color: rgba(255, 255, 255, 0.65);
  }

  .map-widget__title {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    color: var(--text);
  }

  .map-widget__titles {
    display: flex;
    flex-direction: column;
  }

  .map-widget__subtitle {
    margin: 2px 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .map-canvas {
    width: 100%;
    height: 320px;
    overflow: hidden;
    border-top: 1px solid var(--border);
  }

  .map-toggle {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    background: rgba(20, 24, 28, 0.72);
    color: #ffffff;
    display: grid;
    place-items: center;
    z-index: 5;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background 0.15s ease;
  }

  .map-toggle:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
  }

  .map-toggle:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.8);
    outline-offset: 2px;
  }

  .map-toggle__icon {
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .map-toggle__icon svg {
    width: 20px;
    height: 20px;
  }

  .map-toggle__icon--collapse {
    display: none;
  }

  .map-widget[data-map-fullscreen="true"] .map-toggle__icon--expand {
    display: none;
  }

  .map-widget[data-map-fullscreen="true"] .map-toggle__icon--collapse {
    display: inline-flex;
  }

  .map-modal {
    position: fixed;
    inset: 0;
    padding: 4vh 4vw;
    background: rgba(4, 6, 10, 0.72);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }

  .map-widget[data-map-fullscreen="true"] .map-modal {
    display: flex;
  }

  .map-modal__content {
    position: relative;
    width: min(96vw, 1200px);
    height: min(90vh, 780px);
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    background: #0b0f14;
    display: flex;
    flex-direction: column;
  }

  .map-canvas--fullscreen {
    flex: 1;
    width: 100%;
    height: 100%;
    border: none;
  }

  :global(body.map-widget--no-scroll) {
    overflow: hidden;
  }

  :global(.map-marker) {
    width: 54px;
    height: 54px;
    border-radius: 999px;
    background: var(--marker-color, var(--status-included));
    color: #0b0f14;
    display: grid;
    place-items: center;
    border: none;
    box-shadow: 0 6px 12px rgba(15, 23, 42, 0.2);
  }

  :global(.map-marker__glyph) {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }

  :global(.map-marker.status-included) {
    --marker-color: var(--status-included);
  }

  :global(.map-marker.status-possible) {
    --marker-color: var(--status-possible);
  }

  :global(.map-marker.status-avoid) {
    --marker-color: var(--status-avoid);
  }

  :global(.map-marker__glyph svg) {
    width: 30px;
    height: 30px;
    display: block;
  }

  :global(.map-popup) {
    margin: 0;
  }

  :global(.map-popup__title) {
    margin: 0 0 4px;
    font-weight: 600;
  }

  :global(.map-popup__meta) {
    margin: 0 0 6px;
    font-size: 0.8rem;
    color: var(--muted);
  }

  :global(.map-popup__description) {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text);
  }

  :global(.map-popup__link) {
    margin: 6px 0 0;
    font-size: 0.85rem;
  }

  :global(.map-popup__link a) {
    color: var(--accent);
    text-decoration: none;
  }

  :global(.map-popup__link a:hover) {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .map-canvas {
      height: 280px;
    }

    .map-modal {
      padding: 12px;
    }

    .map-modal__content {
      width: 100%;
      height: calc(100vh - 24px);
      border-radius: 16px;
    }
  }
</style>
