---
import mapWidgetScript from "../scripts/mapWidget.js?url";

const {
  markers = [],
  label = "Map overview",
  mapId = "bali-map",
  singleMarkerZoom = 11,
} = Astro.props;

const mapTilerKey = import.meta.env.PUBLIC_MAPTILER_KEY;
const normalizedMarkers = Array.isArray(markers) ? markers : [];
const markerSummaries = normalizedMarkers.map((marker) => {
  const title = marker.title ?? marker.name ?? "(untitled)";
  const rawLat = marker.lat ?? marker.latitude;
  const rawLon = marker.lon ?? marker.lng ?? marker.longitude;
  const lat = Number(rawLat);
  const lon = Number(rawLon);
  const issues: string[] = [];

  if (rawLat == null) {
    issues.push("lat missing");
  } else if (!Number.isFinite(lat)) {
    issues.push("lat invalid");
  } else if (Math.abs(lat) > 90) {
    issues.push("lat out of range");
  }

  if (rawLon == null) {
    issues.push("lon missing");
  } else if (!Number.isFinite(lon)) {
    issues.push("lon invalid");
  } else if (Math.abs(lon) > 180) {
    issues.push("lon out of range");
  }

  return {
    title,
    rawLat,
    rawLon,
    lat,
    lon,
    issues,
  };
});
const validMarkers = markerSummaries
  .filter((marker) => marker.issues.length === 0)
  .map((marker) => ({
    title: marker.title,
    lat: marker.lat,
    lon: marker.lon,
  }));
const invalidMarkers = markerSummaries
  .filter((marker) => marker.issues.length > 0)
  .map((marker) => ({
    title: marker.title,
    rawLat: marker.rawLat ?? "",
    rawLon: marker.rawLon ?? "",
    issues: marker.issues,
  }));

const totalMarkers = normalizedMarkers.length;
const validMarkersCount = validMarkers.length;
const invalidMarkersCount = invalidMarkers.length;

if (!mapTilerKey) {
  console.warn("[MapWidget] Missing PUBLIC_MAPTILER_KEY; map hidden.");
}

const shouldRenderMap = Boolean(mapTilerKey) && validMarkers.length > 0;
const mapConfig = {
  label,
  mapId,
  markers: validMarkers,
  mapTilerKey,
  singleMarkerZoom,
  totalMarkers,
  validMarkersCount,
  invalidMarkersCount,
  invalidMarkers,
  shouldRenderMap,
};
---
{shouldRenderMap && (
  <section
    class="map-widget"
    aria-label={label}
    data-map-widget
    data-map-config={JSON.stringify(mapConfig)}
  >
    <h3 class="map-title">{label}</h3>
    <div id={mapId} class="map-canvas" aria-label={`${label} map`} role="region"></div>
  </section>
)}

{!shouldRenderMap && (
  <div data-map-widget hidden data-map-config={JSON.stringify(mapConfig)}></div>
)}

<!-- Leaflet assets load via CDN to avoid bare module imports on static hosting. -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  crossorigin="anonymous"
/>
<script
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  defer
  crossorigin="anonymous"
></script>
<script src={mapWidgetScript} defer></script>

<style>
  .map-widget {
    display: grid;
    gap: 12px;
  }

  .map-title {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    color: var(--text);
  }

  .map-canvas {
    width: 100%;
    height: 320px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    .map-canvas {
      height: 280px;
    }
  }
</style>
