---
import "leaflet/dist/leaflet.css";

const {
  markers = [],
  label = "Map overview",
  mapId = "bali-map",
  singleMarkerZoom = 11,
} = Astro.props;

const mapTilerKey = import.meta.env.PUBLIC_MAPTILER_KEY;
const normalizedMarkers = Array.isArray(markers) ? markers : [];
const markerSummaries = normalizedMarkers.map((marker) => {
  const title = marker.title ?? marker.name ?? "(untitled)";
  const rawLat = marker.lat ?? marker.latitude;
  const rawLon = marker.lon ?? marker.lng ?? marker.longitude;
  const lat = Number(rawLat);
  const lon = Number(rawLon);
  const issues: string[] = [];

  if (rawLat == null) {
    issues.push("lat missing");
  } else if (!Number.isFinite(lat)) {
    issues.push("lat invalid");
  } else if (Math.abs(lat) > 90) {
    issues.push("lat out of range");
  }

  if (rawLon == null) {
    issues.push("lon missing");
  } else if (!Number.isFinite(lon)) {
    issues.push("lon invalid");
  } else if (Math.abs(lon) > 180) {
    issues.push("lon out of range");
  }

  return {
    title,
    rawLat,
    rawLon,
    lat,
    lon,
    issues,
  };
});
const validMarkers = markerSummaries
  .filter((marker) => marker.issues.length === 0)
  .map((marker) => ({
    title: marker.title,
    lat: marker.lat,
    lon: marker.lon,
  }));
const invalidMarkers = markerSummaries
  .filter((marker) => marker.issues.length > 0)
  .map((marker) => ({
    title: marker.title,
    rawLat: marker.rawLat ?? "",
    rawLon: marker.rawLon ?? "",
    issues: marker.issues,
  }));

const totalMarkers = normalizedMarkers.length;
const validMarkersCount = validMarkers.length;
const invalidMarkersCount = invalidMarkers.length;

if (!mapTilerKey) {
  console.warn("[MapWidget] Missing PUBLIC_MAPTILER_KEY; map hidden.");
}

const shouldRenderMap = Boolean(mapTilerKey) && validMarkers.length > 0;
---

{shouldRenderMap && (
  <section class="map-widget" aria-label={label}>
    <h3 class="map-title">{label}</h3>
    <div id={mapId} class="map-canvas" aria-label={`${label} map`} role="region"></div>
    <script
      type="module"
      define:vars={{
        mapId,
        markers: validMarkers,
        mapTilerKey,
        singleMarkerZoom,
        totalMarkers,
        validMarkersCount,
        invalidMarkersCount,
        invalidMarkers,
      }}
    >
      import L from "leaflet";
      import iconRetinaUrl from "leaflet/dist/images/marker-icon-2x.png";
      import iconUrl from "leaflet/dist/images/marker-icon.png";
      import shadowUrl from "leaflet/dist/images/marker-shadow.png";

      const logDebug = (message, data) => {
        window.travelsDebugLog?.("MapWidget", message, data ?? "");
      };
      const formatMarkerList = (items, formatter, emptyLabel = "  - none") => {
        if (!items.length) {
          return emptyLabel;
        }

        return items.map(formatter).join("\n");
      };
      const formatRawValue = (value) => (value === "" ? "?" : String(value));
      const keyPresent = Boolean(mapTilerKey);
      const keyLength = mapTilerKey?.length ?? 0;
      const keyPrefix = keyPresent ? mapTilerKey.slice(0, 4) : "";
      const initData = [
        `url: ${window.location.href}`,
        `container: #${mapId}`,
        `maptilerKeyPresent: ${keyPresent}`,
        `maptilerKeyLen: ${keyLength}`,
        keyPresent ? `maptilerKeyPrefix: ${keyPrefix}` : null,
        `markersTotal: ${totalMarkers}`,
        `markersValid: ${validMarkersCount}`,
        `markersInvalid: ${invalidMarkersCount}`,
      ]
        .filter(Boolean)
        .join("\n");
      const markersData = [
        "valid:",
        formatMarkerList(
          markers,
          (marker) => `  - ${marker.title}: ${marker.lat}, ${marker.lon}`
        ),
        "invalid:",
        formatMarkerList(
          invalidMarkers,
          (marker) =>
            `  - ${marker.title}: ${formatRawValue(marker.rawLat)}, ${formatRawValue(
              marker.rawLon
            )} (${marker.issues.join(
              ", "
            )})`
        ),
      ].join("\n");

      logDebug("Init", initData);
      logDebug("Markers", markersData);

      const mapElement = document.getElementById(mapId);
      if (!mapElement) {
        logDebug("Error", `Missing map container #${mapId}`);
      }

      try {
        if (mapElement) {
          L.Icon.Default.mergeOptions({
            iconRetinaUrl,
            iconUrl,
            shadowUrl,
          });

          logDebug("Loading", "Map container ready, initializing Leaflet.");

          const map = L.map(mapElement, {
            scrollWheelZoom: false,
          });

          const tileLayer = L.tileLayer(
            `https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=${mapTilerKey}`,
            {
              attribution:
                '&copy; <a href="https://www.maptiler.com/copyright/">MapTiler</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
            }
          );
          tileLayer.on("tileerror", (event) => {
            const error = event?.error;
            const errorMessage =
              error instanceof Error
                ? `${error.message}${error.stack ? `\n${error.stack}` : ""}`
                : error
                  ? String(error)
                  : "Unknown tile error";
            logDebug("Tile error", errorMessage);
          });

          tileLayer.addTo(map);

          const bounds = L.latLngBounds([]);

          markers.forEach((marker) => {
            const position = [marker.lat, marker.lon];
            L.marker(position, { title: marker.title }).addTo(map);
            bounds.extend(position);
          });

          let boundsDecision = "none";
          let fitBounds = false;
          if (markers.length === 1) {
            map.setView([markers[0].lat, markers[0].lon], singleMarkerZoom);
            boundsDecision = "single marker zoom";
          } else if (markers.length > 1) {
            map.fitBounds(bounds, { padding: [24, 24] });
            boundsDecision = "fit bounds";
            fitBounds = true;
          }

          logDebug(
            "Ready",
            [
              `markersPlaced: ${markers.length}`,
              `fitBounds: ${fitBounds}`,
              `boundsDecision: ${boundsDecision}`,
              "tiles: requested",
            ].join("\n")
          );
        }
      } catch (error) {
        const message =
          error instanceof Error
            ? `${error.message}${error.stack ? `\n${error.stack}` : ""}`
            : String(error);
        logDebug("Error", message);
      }
    </script>
  </section>
)}

{!shouldRenderMap && (
  <script
    type="module"
    define:vars={{
      mapTilerKey,
      totalMarkers,
      validMarkersCount,
      invalidMarkersCount,
      markers: validMarkers,
      invalidMarkers,
    }}
  >
    const logDebug = (message, data) => {
      window.travelsDebugLog?.("MapWidget", message, data ?? "");
    };
    const formatMarkerList = (items, formatter, emptyLabel = "  - none") => {
      if (!items.length) {
        return emptyLabel;
      }

      return items.map(formatter).join("\n");
    };
    const formatRawValue = (value) => (value === "" ? "?" : String(value));
    const keyPresent = Boolean(mapTilerKey);
    const keyLength = mapTilerKey?.length ?? 0;
    const keyPrefix = keyPresent ? mapTilerKey.slice(0, 4) : "";
    const initData = [
      `url: ${window.location.href}`,
      "container: (not rendered)",
      `maptilerKeyPresent: ${keyPresent}`,
      `maptilerKeyLen: ${keyLength}`,
      keyPresent ? `maptilerKeyPrefix: ${keyPrefix}` : null,
      `markersTotal: ${totalMarkers}`,
      `markersValid: ${validMarkersCount}`,
      `markersInvalid: ${invalidMarkersCount}`,
    ]
      .filter(Boolean)
      .join("\n");
    const markersData = [
      "valid:",
      formatMarkerList(
        markers,
        (marker) => `  - ${marker.title}: ${marker.lat}, ${marker.lon}`
      ),
      "invalid:",
      formatMarkerList(
        invalidMarkers,
        (marker) =>
          `  - ${marker.title}: ${formatRawValue(marker.rawLat)}, ${formatRawValue(
            marker.rawLon
          )} (${marker.issues.join(
            ", "
          )})`
      ),
    ].join("\n");

    logDebug("Init", initData);
    logDebug("Markers", markersData);
  </script>
)}

<style>
  .map-widget {
    display: grid;
    gap: 12px;
  }

  .map-title {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    color: var(--text);
  }

  .map-canvas {
    width: 100%;
    height: 320px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    .map-canvas {
      height: 280px;
    }
  }
</style>
