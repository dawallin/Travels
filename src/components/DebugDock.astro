---
import DebugWidget from "./DebugWidget.astro";

const { pageKey } = Astro.props;
---
<div class="debug-toggle-container">
  <button
    class="debug-toggle-button"
    type="button"
    data-debug-toggle-button
    aria-label="Toggle debug"
  >
    🐞
  </button>
</div>
<DebugWidget pageKey={pageKey} />

<style>
  .debug-toggle-container {
    position: fixed;
    top: 14px;
    right: 14px;
    z-index: 1100;
  }

  .debug-toggle-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.12);
  }

  .debug-toggle-button:hover {
    color: var(--text);
  }

  .debug-toggle-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 540px) {
    .debug-toggle-container {
      top: 10px;
      right: 10px;
    }

    .debug-toggle-button {
      width: 30px;
      height: 30px;
      font-size: 15px;
    }
  }
</style>
