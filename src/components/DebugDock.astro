---
import DebugWidget from "./DebugWidget.astro";
import debugDockUrl from "../scripts/debugDock.js?url";
---
<script is:inline>
  (() => {
    if (typeof window === "undefined") {
      return;
    }

    if (window.__travelsDebugStore) {
      return;
    }

    const MAX_ENTRIES = 200;
    let entries = [];
    let index = 0;
    const subscribers = new Set();

    const notify = () => {
      const snapshot = entries.slice();
      subscribers.forEach((subscriber) => {
        subscriber(snapshot);
      });
    };

    const normalizeString = (value, fallback = "") => {
      if (value == null) {
        return fallback;
      }

      return String(value);
    };

    const appendEntry = (source, message, data = "") => {
      const entry = {
        index,
        source: normalizeString(source, "Unknown"),
        message: normalizeString(message, ""),
        data: normalizeString(data, ""),
      };
      index += 1;
      entries = entries.concat(entry).slice(-MAX_ENTRIES);
      notify();
    };

    const seedEntries = (seed) => {
      if (!Array.isArray(seed) || seed.length === 0) {
        return;
      }

      seed.forEach((entry) => {
        if (!entry || typeof entry !== "object") {
          return;
        }

        appendEntry(entry.source, entry.message, entry.data ?? "");
      });
    };

    const store = {
      log: appendEntry,
      clear: () => {
        entries = [];
        notify();
      },
      getAll: () => entries.slice(),
      subscribe: (subscriber) => {
        subscribers.add(subscriber);
        subscriber(entries.slice());
        return () => {
          subscribers.delete(subscriber);
        };
      },
      seed: seedEntries,
    };

    window.__travelsDebugStore = store;
    window.travelsDebugLog = (source, message, data) => {
      store.log(source, message, data ?? "");
    };

    if (window.__travelsDebugSeed) {
      store.seed(window.__travelsDebugSeed);
      window.__travelsDebugSeed = [];
    }

    window.addEventListener("error", (event) => {
      const error = event?.error;
      const message =
        error instanceof Error
          ? error.message
          : normalizeString(event?.message, "Unhandled error");
      const data = [
        `message: ${normalizeString(event?.message, "Unknown error")}`,
        event?.filename ? `file: ${event.filename}` : null,
        Number.isFinite(event?.lineno) ? `line: ${event.lineno}` : null,
        Number.isFinite(event?.colno) ? `column: ${event.colno}` : null,
        error instanceof Error && error.stack ? `stack:\n${error.stack}` : null,
      ]
        .filter(Boolean)
        .join("\n");

      window.travelsDebugLog?.("Runtime Error", message, data);
    });

    window.addEventListener("unhandledrejection", (event) => {
      const reason = event?.reason;
      const message =
        reason instanceof Error
          ? reason.message
          : normalizeString(reason, "Unhandled promise rejection");
      const detail =
        reason instanceof Error
          ? `${reason.message}${reason.stack ? `\n${reason.stack}` : ""}`
          : normalizeString(reason, "Unknown rejection");

      window.travelsDebugLog?.("Unhandled Rejection", message, detail);
    });
  })();
</script>
<div class="debug-toggle-container">
  <button
    class="debug-toggle-button"
    type="button"
    data-debug-toggle-button
    aria-label="Toggle debug"
  >
    🐞
  </button>
</div>
<DebugWidget />
<script type="module" src={debugDockUrl}></script>

<style>
  .debug-toggle-container {
    position: fixed;
    top: calc(14px + env(safe-area-inset-top, 0px));
    right: calc(14px + env(safe-area-inset-right, 0px));
    z-index: 1100;
  }

  .debug-toggle-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.12);
  }

  .debug-toggle-button:hover {
    color: var(--text);
  }

  .debug-toggle-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 540px) {
    .debug-toggle-container {
      top: calc(10px + env(safe-area-inset-top, 0px));
      right: calc(10px + env(safe-area-inset-right, 0px));
    }

    .debug-toggle-button {
      width: 30px;
      height: 30px;
      font-size: 15px;
    }
  }
</style>
