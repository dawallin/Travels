---
import Card from "./Card.astro";
import {
  placeStatusChipLabels,
  placeStatusColors,
  placeTypeIcons,
  placeTypeLabels,
} from "./placePresentation";

const { place, href } = Astro.props;

const statusColor = placeStatusColors[place.status] ?? placeStatusColors.included;
const statusLabel = placeStatusChipLabels[place.status];
const typeKey = place.type ?? "destination";
const badgeLabel = placeTypeLabels[typeKey] ?? "Place";
const badgeIcon = placeTypeIcons[typeKey] ?? placeTypeIcons.destination;
const chip = statusLabel ? { label: statusLabel, tone: place.status } : null;
---

<Card
  title={place.title}
  description={place.description}
  href={href}
  class="place-card"
  badge={{ color: statusColor, icon: badgeIcon, label: badgeLabel }}
  chip={chip}
  badgeArea={56}
/>
