---
import PlaceCard from "./PlaceCard.astro";

const tripId = "bali";
const placeModules = import.meta.glob("../data/places/bali/*.ts", { eager: true });
const contentModules = import.meta.glob("../pages/trips/bali/places/*.md", { eager: true });

const places = Object.values(placeModules).map((module) => module.default ?? module.place ?? module);
const contentIds = new Set(
  Object.keys(contentModules).map((path) => path.split("/").pop()?.replace(".md", ""))
);

const notchMetrics = {
  width: 12,
  gap: 4,
  padding: 6,
};
const notchArea = (count) =>
  count > 0
    ? notchMetrics.padding * 2 + count * notchMetrics.width + (count - 1) * notchMetrics.gap
    : 0;

const statusNotches = {
  included: { label: "Included", color: "#3f8f5f" },
  possible: { label: "Possible", color: "#f2b531" },
  avoid: { label: "Avoid", color: "#c57a7a" },
};

const sortedPlaces = [...places].sort((a, b) => a.title.localeCompare(b.title));
const destinationPlaces = sortedPlaces.filter(
  (place) => place.type === "destination" && place.parentDestinationId === tripId
);
const destinationIds = new Set(destinationPlaces.map((place) => place.id));

const childrenByParent = new Map();
const ungroupedPlaces = [];

sortedPlaces.forEach((place) => {
  const isDestination = place.type === "destination" && place.parentDestinationId === tripId;
  if (!isDestination) {
    const isChild = place.type !== "destination" && destinationIds.has(place.parentDestinationId);
    if (isChild) {
      const group = childrenByParent.get(place.parentDestinationId) ?? [];
      group.push(place);
      childrenByParent.set(place.parentDestinationId, group);
    } else {
      ungroupedPlaces.push(place);
    }
  }
});

const getContentHref = (placeId) => (contentIds.has(placeId) ? `places/${placeId}/` : null);
const getPlaceCardProps = (place) => ({
  place,
  notch: statusNotches[place.status] ?? statusNotches.possible,
  href: getContentHref(place.id),
  notchArea: notchArea(1),
});
---
<section class="places-overview">
  {destinationPlaces.map((destination) => {
    const destinationCardProps = getPlaceCardProps(destination);
    const destinationChildren = childrenByParent.get(destination.id) ?? [];
    return (
      <div class="destination-group">
        <div class="destination-card">
          <PlaceCard {...destinationCardProps} />
        </div>
        {destinationChildren.length > 0 && (
          <div class="child-list">
            {destinationChildren.map((place) => {
              const childCardProps = getPlaceCardProps(place);
              return (
                <div class="child-card">
                  <PlaceCard {...childCardProps} />
                </div>
              );
            })}
          </div>
        )}
      </div>
    );
  })}

  {ungroupedPlaces.length > 0 && (
    <div class="ungrouped">
      <h3>Ungrouped</h3>
      <div class="child-list">
        {ungroupedPlaces.map((place) => {
          const cardProps = getPlaceCardProps(place);
          return (
            <div class="child-card">
              <PlaceCard {...cardProps} />
            </div>
          );
        })}
      </div>
    </div>
  )}
</section>

<style>
  .places-overview {
    display: grid;
    gap: 28px;
  }

  .destination-group,
  .ungrouped {
    display: grid;
    gap: 16px;
  }

  .child-list {
    display: grid;
    gap: 14px;
    padding-left: 18px;
  }

  .ungrouped h3 {
    margin: 0;
    font-size: 1.05rem;
    color: var(--muted);
    letter-spacing: 0.01em;
  }

  .idea-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    background: #fbfbfc;
    position: relative;
    padding: 20px 24px 32px calc(20px + var(--notch-area, 0px));
    display: block;
  }

  .idea-card:hover,
  .idea-card:focus {
    border-color: var(--accent);
  }

  .idea-card--static {
    cursor: default;
  }

  .idea-card--static:hover,
  .idea-card--static:focus {
    border-color: var(--border);
  }

  .notch-stack {
    position: absolute;
    inset: 0 auto 0 0;
    display: flex;
    align-items: stretch;
    gap: var(--notch-gap);
    padding: 8px var(--notch-padding);
    width: var(--notch-area);
    pointer-events: none;
  }

  .notch {
    background: var(--notch-color, #e6ebef);
    color: var(--text);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: var(--notch-width);
    border-radius: 8px;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    white-space: nowrap;
  }

  .idea-card-content {
    display: grid;
    gap: 8px;
  }

  .idea-title {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .idea-meta {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .type-badge {
    position: absolute;
    bottom: 12px;
    right: 16px;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 8px;
    border-radius: 999px;
    background: #eef1f4;
    color: #4b5563;
  }

  @media (max-width: 640px) {
    .child-list {
      padding-left: 12px;
    }
  }
</style>
