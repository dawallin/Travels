---
import PageHeader from "../components/PageHeader.astro";
import DebugDock from "../components/DebugDock.astro";
import type { Place } from "../types/place";

const {
  title,
  place,
  backHref = "../../",
  backLabel = "← Back to Bali overview",
  renderStructuredDetails = false,
  renderMarkdownContent,
} = Astro.props as {
  title?: string;
  place?: Place;
  backHref?: string;
  backLabel?: string;
  renderStructuredDetails?: boolean;
  renderMarkdownContent?: boolean;
};

const hasDefaultSlot = Astro.slots.has("default");
const shouldRenderMarkdownContent = renderMarkdownContent ?? hasDefaultSlot;
const pageTitle = place?.title ?? title;
const details = place?.details;
const links = place?.links;
const highlightItems = details?.highlights?.filter(Boolean) ?? [];
const tipItems = details?.tips?.filter(Boolean) ?? [];
const linkEntries = links
  ? ([
      ["Google Maps", links.googleMaps],
      ["TripAdvisor", links.tripAdvisor],
      ["Official site", links.official],
    ] as const).filter(([, href]) => Boolean(href))
  : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle} • Travels</title>
    <style>
      :root {
        color-scheme: light;
        --text: #1f2933;
        --muted: #5b6570;
        --border: #d7dce1;
        --surface: #ffffff;
        --background: #f6f7f9;
        --accent: #2f5d7c;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
        color: var(--text);
        background: var(--background);
      }

      main {
        max-width: 960px;
        margin: 0 auto;
        padding: 64px 24px 104px;
        display: grid;
        gap: 24px;
      }

      a {
        color: var(--accent);
      }

      h1 {
        margin: 0 0 12px;
        font-size: 2.4rem;
        letter-spacing: -0.02em;
      }

      p {
        margin: 0;
        line-height: 1.6;
        color: var(--text);
      }

      .section {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 28px 32px;
      }

      .section h2 {
        margin: 0 0 12px;
        font-size: 1.15rem;
        letter-spacing: -0.01em;
      }

      .section ul {
        margin: 0;
        padding-left: 22px;
        display: grid;
        gap: 10px;
      }

      .section :global(p + p) {
        margin-top: 16px;
      }

      .hero-image {
        width: 100%;
        border-radius: 10px;
        border: 1px solid var(--border);
        display: block;
      }

      .links-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 10px;
      }

      .markdown-content :global(p),
      .markdown-content :global(li) {
        line-height: 1.6;
      }

      .markdown-content :global(p) {
        margin: 0 0 16px;
      }

      .markdown-content :global(ul) {
        margin: 0;
        padding-left: 22px;
      }
    </style>
  </head>
  <body>
    <DebugDock />
    <main>
      <PageHeader title={pageTitle} backHref={backHref} backLabel={backLabel} />

      {place?.heroImage && (
        <section class="section">
          <img class="hero-image" src={place.heroImage} alt={place.title} loading="lazy" />
        </section>
      )}

      {place?.description && (
        <section class="section">
          <h2>Description</h2>
          <p>{place.description}</p>
        </section>
      )}

      {renderStructuredDetails && details?.what && (
        <>
          <section class="section">
            <h2>What</h2>
            <p>{details.what}</p>
            {details.summary && <p>{details.summary}</p>}
          </section>

          {highlightItems.length > 0 && (
            <section class="section">
              <h2>Highlights</h2>
              <ul>
                {highlightItems.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          )}

          {tipItems.length > 0 && (
            <section class="section">
              <h2>Tips</h2>
              <ul>
                {tipItems.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          )}
        </>
      )}

      {linkEntries.length > 0 && (
        <section class="section">
          <h2>Links</h2>
          <ul class="links-list">
            {linkEntries.map(([label, href]) => (
              <li><a href={href} target="_blank" rel="noreferrer">{label}</a></li>
            ))}
          </ul>
        </section>
      )}

      {shouldRenderMarkdownContent && (
        <section class="section markdown-content">
          <slot />
        </section>
      )}
    </main>
  </body>
</html>
